---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/95 backdrop-blur-sm shadow-sm" id="site-header">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <a href="/" class="flex items-center gap-3 no-underline" aria-label="Solar Center by Dura-Foam — Home">
        <img src="/logos/logo-header.svg" alt="Solar Center by Dura-Foam" width="200" height="100" loading="eager" class="h-14 w-auto" />
      </a>

      <nav class="hidden lg:flex items-center gap-5 xl:gap-6" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'whitespace-nowrap text-sm font-medium transition-colors hover:text-solar-navy no-underline',
              currentPath === link.href ? 'text-solar-navy font-semibold' : 'text-slate',
            ]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}

        <!-- Resources Dropdown -->
        <div class="relative" id="resources-dropdown">
          <button
            type="button"
            class:list={[
              'flex items-center gap-1 whitespace-nowrap text-sm font-medium transition-colors hover:text-solar-navy no-underline bg-transparent border-none cursor-pointer',
              isResourcePage ? 'text-solar-navy font-semibold' : 'text-slate',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
            id="resources-trigger"
          >
            Resources
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200" id="resources-chevron" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>

          <div
            id="resources-menu"
            class="invisible opacity-0 absolute top-full right-0 mt-2 w-[320px] rounded-xl bg-white border border-gray-200 shadow-xl p-4 transition-all duration-200 -translate-y-2"
            role="menu"
          >
            <div class="space-y-0.5">
              {resourceLinks.map((link) => (
                <a
                  href={link.href}
                  class:list={['group flex items-center gap-3 rounded-lg px-2 py-1.5 text-sm no-underline transition-colors hover:bg-warm-sand hover:text-solar-navy', currentPath === link.href ? 'text-solar-navy font-semibold bg-warm-sand' : 'text-slate']}
                  role="menuitem"
                >
                  <span class:list={['flex h-8 w-8 flex-none items-center justify-center rounded-md text-accent-strong transition-colors', currentPath === link.href ? 'bg-white' : 'bg-warm-sand group-hover:bg-white']} aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={link.icon} /></svg>
                  </span>
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Service Areas Dropdown -->
        <div class="relative" id="service-areas-dropdown">
          <button
            type="button"
            class:list={[
              'flex items-center gap-1 whitespace-nowrap text-sm font-medium transition-colors hover:text-solar-navy no-underline bg-transparent border-none cursor-pointer',
